<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>qcar2_planner</name>
    <version>1.0.0</version>
    <description>
      Auto-mapping and directional path planning for QCar2.
      Generates nav_msgs/Path respecting right-hand driving via oriented A*.
      Does NOT control motors.
    </description>
    <maintainer email="brayandurantoconas@gmail.com">hackbrian</maintainer>
    <license>MIT</license>

    <!-- Build tools -->
    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>rosidl_default_generators</buildtool_depend>

    <!-- ROS 2 core -->
    <depend>rclpy</depend>
    <depend>std_srvs</depend>

    <!-- Messages -->
    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>visualization_msgs</depend>
    <depend>grid_map_msgs</depend>
    <depend>std_msgs</depend>

    <!-- Perception & TF -->
    <depend>tf2_ros</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>cv_bridge</depend>

    <!-- Python libs -->
    <depend>python3-opencv</depend>
    <depend>python3-numpy</depend>

    <!-- rosidl runtime (for custom srv) -->
    <exec_depend>rosidl_default_runtime</exec_depend>
    <exec_depend>ros2launch</exec_depend>

    <member_of_group>rosidl_interface_packages</member_of_group>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
